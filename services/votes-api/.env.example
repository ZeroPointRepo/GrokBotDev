# grokbot votes API — local development example (copy to .env; do not commit .env)
NODE_ENV=development
VOTES_HOST=127.0.0.1
VOTES_PORT=4391
DATABASE_URL=postgres://votes_app:local_votes_app_password@127.0.0.1:54390/grokbot_votes
ADMIN_DATABASE_URL=postgres://votes_admin:local_votes_admin_password@127.0.0.1:54390/grokbot_votes
MIGRATE_DATABASE_URL=postgres://postgres:local_postgres_password@127.0.0.1:54390/grokbot_votes
VOTES_APP_PASSWORD=local_votes_app_password
VOTES_ADMIN_PASSWORD=local_votes_admin_password
VOTES_HMAC_PEPPER=replace-with-openssl-rand-hex-32
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
USE_CASE_CONTENT_DIR=../../content/use-cases
SLUGS_FILE=../../dist/api-meta/use-case-slugs.json
LOG_LEVEL=info

# /submit/ bot submissions. Both optional — these are the defaults. The file is tried first and
# the URL is the fallback; if neither answers, the "already live" dedupe is skipped (the table's
# UNIQUE constraint and the reviewer still catch duplicates).
SUBMISSIONS_MANIFEST_FILE=../../dist/api/v1/templates.json
SUBMISSIONS_MANIFEST_URL=https://grokbot.dev/api/v1/templates.json
SUBMISSIONS_MANIFEST_TTL_MS=300000
SHARE_LINK_TIMEOUT_MS=2500
