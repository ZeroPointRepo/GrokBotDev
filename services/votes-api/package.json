{
  "name": "grokbot-votes-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "db:start": "bash scripts/start-postgres.sh",
    "db:migrate": "tsx src/db/migrate.ts",
    "recount": "tsx bin/recount.ts",
    "review-flags": "tsx bin/review-flags.ts",
    "digest": "tsx bin/digest.ts",
    "review-submissions": "tsx bin/review-submissions.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.18.2",
    "dotenv": "^17.2.1",
    "hono": "^4.9.2",
    "postgres": "^3.4.7",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
